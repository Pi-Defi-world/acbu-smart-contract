// SPDX-License-Identifier: MIT
/// # KYC Verifier Circuit
///
/// Proves that an account satisfies a KYC tier constraint without revealing
/// the underlying KYC score.
///
/// ## Public inputs
///
/// | Field                 | Description                                                      |
/// |-----------------------|------------------------------------------------------------------|
/// | `min_tier`            | Minimum KYC tier required (0–3)                                  |
/// | `country_code`        | ISO-3166-1 numeric country code of the account                   |
/// | `requested_amount`    | Transaction amount in protocol units (7 decimals)                |
/// | `daily_cap`           | Per-tier daily cap (0 = blocked, `Field::max_value` = unlimited) |
/// | `already_used`        | Amount already consumed in the current daily window              |
/// | `wallet_address_hash` | SHA-256 of the submitting wallet address (first 16 bytes as u128)|
///
/// ## W10-SEC-015 — Caller identity binding
///
/// In addition to `wallet_address_hash`, the circuit binds a per-account
/// identity commitment `identity_commitment` into its public inputs.  The
/// on-chain verifier recomputes the commitment from the caller's address and
/// a registered per-account salt, and checks it equals `public_inputs[6]`.
/// This ensures a proof is valid only for the intended on-chain account.
///
/// ## AZ-032 — Caller binding
///
/// `wallet_address_hash` commits the proof to a specific wallet address.
/// The on-chain verifier (zk_verifier) recomputes `sha256(wallet)[..16]`
/// from `env.invoker()` / `wallet` and checks it equals `public_inputs[5]`.
/// This prevents an attacker from re-submitting a proof generated by someone
/// else to mark a different address as verified.
///
/// ## Private inputs
///
/// | Field        | Description                                                    |
/// |--------------|----------------------------------------------------------------|
/// | `kyc_score`  | The account's raw KYC score (0–100)                            |
/// | `tier`       | Derived tier (0–3); must be consistent with `kyc_score`       |
/// | `identity_salt` | Per-account secret salt used to derive `identity_commitment`|
///
/// ## Constraints
///
/// 1. `kyc_score` is in range [0, 100].
/// 2. `tier` is correctly derived from `kyc_score`.
/// 3. `tier >= min_tier` (tier gate).
/// 4. `requested_amount > 0`.
/// 5. `already_used + requested_amount <= daily_cap`  (unless daily_cap == 0xFFFF…FF).
/// 6. `identity_commitment == pedersen(wallet_address_hash, identity_salt)`
///    (W10-SEC-015 caller binding).

// ── Score-to-tier derivation ────────────────────────────────────────────────

/// Derives a KYC tier (0–3) from a numeric score.
///
/// Tier boundaries:
///   tier 0 :  score < 30
///   tier 1 : 30 <= score < 60
///   tier 2 : 60 <= score < 90
///   tier 3 : score >= 90
fn score_to_tier(score: Field) -> Field {
    // Cast to u8 for arithmetic; constrain range in caller.
    let s = score as u8;
    if s >= 90 {
        3
    } else if s >= 60 {
        2
    } else if s >= 30 {
        1
    } else {
        0
    }
}

// ── Tier-1 country allow-list ───────────────────────────────────────────────
//
// ISO 3166-1 numeric codes for the Tier-1 allow-list:
//   566 = NG (Nigeria)
//   404 = KE (Kenya)
//   710 = ZA (South Africa)
//   288 = GH (Ghana)
//   646 = RW (Rwanda)
//   818 = EG (Egypt)
//   504 = MA (Morocco)
//   508 = MZ (Mozambique)
//   686 = SN (Senegal)
//   834 = TZ (Tanzania)
//   800 = UG (Uganda)
//   894 = ZM (Zambia)

fn is_country_allowed_tier1(country_code: Field) -> bool {
    let c = country_code as u32;
    (c == 566)
        | (c == 404)
        | (c == 710)
        | (c == 288)
        | (c == 646)
        | (c == 818)
        | (c == 504)
        | (c == 508)
        | (c == 686)
        | (c == 834)
        | (c == 800)
        | (c == 894)
}

// ── Main circuit ────────────────────────────────────────────────────────────

fn main(
    // Public inputs
    min_tier: pub u8,
    country_code: pub Field,
    requested_amount: pub Field,
    daily_cap: pub Field,
    already_used: pub Field,
    // AZ-032: commit the proof to the submitting wallet.
    // This is the first 16 bytes of sha256(wallet_address_xdr) interpreted as
    // a little-endian u128.  The on-chain verifier recomputes this from the
    // transaction invoker and checks equality against this public input.
    wallet_address_hash: pub u128,

    // W10-SEC-015: per-account identity commitment.  The on-chain verifier
    // recomputes this from the caller's wallet hash and registered salt and
    // checks it equals this public input, binding the proof to the account.
    identity_commitment: pub Field,

    // Private inputs
    kyc_score: Field,
    tier: Field,
    identity_salt: Field,
) {
    // ── Constraint 0: wallet binding (AZ-032) ──────────────────────────────
    // The wallet_address_hash must be non-zero; a zero value signals that the
    // prover skipped the binding, which is not allowed.
    assert(wallet_address_hash != 0, "wallet_address_hash must be non-zero (AZ-032)");

    // ── Constraint 0b: caller identity binding (W10-SEC-015) ───────────────
    // The identity commitment must be non-zero and must equal the Pedersen
    // hash of the wallet hash and the per-account salt.  This binds the proof
    // to a specific on-chain account, not merely to possession of a credential.
    assert(identity_commitment != 0, "identity_commitment must be non-zero (W10-SEC-015)");
    let expected_commitment = std::hash::pedersen_hash([wallet_address_hash as Field, identity_salt]);
    assert(expected_commitment == identity_commitment, "identity_commitment mismatch (W10-SEC-015)");
    assert(expected_commitment == identity_commitment, "identity_commitment mismatch (W10-SEC-015)");

    // ── Constraint 1: score in [0, 100] ────────────────────────────────────
    let s = kyc_score as u8;
    assert(s as Field == kyc_score, "kyc_score must fit in u8");
    assert(s <= 100, "kyc_score must be <= 100");

    // ── Constraint 2: tier consistent with score ────────────────────────────
    let derived = score_to_tier(kyc_score);
    assert(derived == tier, "tier must match kyc_score");

    // ── Constraint 3: tier gate ─────────────────────────────────────────────
    let t = tier as u8;
    assert(t >= min_tier, "account tier does not meet minimum requirement");

    // ── Constraint 4: positive amount ──────────────────────────────────────
    // Treat requested_amount as u64 so we can compare > 0.
    let ra = requested_amount as u64;
    assert(ra > 0, "requested_amount must be positive");

    // ── Constraint 5a: tier-0 blocked ──────────────────────────────────────
    assert(t != 0, "tier 0 accounts cannot transact");

    // ── Constraint 5b: tier-1 country check ────────────────────────────────
    if t == 1 {
        assert(
            is_country_allowed_tier1(country_code),
            "country not on tier-1 allow-list"
        );
    }

    // ── Constraint 5c: daily cap ────────────────────────────────────────────
    //
    // The sentinel value 2^64-1 means "unlimited" (Tier 3).
    // We compare as u64 to stay within Noir's native integer range.
    let cap_u64 = daily_cap as u64;
    let used_u64 = already_used as u64;

    let unlimited: u64 = 0xFFFFFFFFFFFFFFFF;

    if cap_u64 != unlimited {
        // Check that already_used + requested <= cap (no overflow).
        let new_total = used_u64 + ra;
        assert(new_total >= used_u64, "daily window overflow"); // overflow guard
        assert(new_total <= cap_u64, "daily cap exceeded");
    }
}

// ── Tests ───────────────────────────────────────────────────────────────────

// A non-zero sentinel used as wallet_address_hash in all positive tests.
// In production this is sha256(wallet_xdr)[..16] as u128, computed off-chain.
global MOCK_WALLET_HASH: u128 = 0x0102030405060708090a0b0c0d0e0f10;

// A non-zero sentinel salt used to derive the identity commitment in tests.
global MOCK_IDENTITY_SALT: Field = 0x0badc0de;

#[test]
fn test_tier3_institutional_passes() {
    // Score 95 → tier 3, min_tier 3, NG, 500_000 ACBU, unlimited cap
    main(
        3,                    // min_tier
        566,                  // country_code = NG
        5_000_000_000_000,    // requested_amount = 500 000 ACBU (7 dec)
        0xFFFFFFFFFFFFFFFF,   // daily_cap = unlimited
        0,                    // already_used
        MOCK_WALLET_HASH,     // wallet_address_hash (AZ-032)
        std::hash::pedersen_hash([MOCK_WALLET_HASH as Field, MOCK_IDENTITY_SALT]), // identity_commitment
        95,                   // kyc_score (private)
        3,                    // tier (private)
    );
}

#[test]
fn test_tier2_standard_passes() {
    // Score 65 → tier 2, min_tier 2, US country (not on tier-1 list, allowed for tier 2)
    main(
        2,                   // min_tier
        840,                 // country_code = US (ISO 3166-1 numeric)
        1_000_000_000_000,   // requested_amount = 100 000 ACBU
        1_000_000_000_000,   // daily_cap = 100 000 ACBU
        0,                   // already_used
        MOCK_WALLET_HASH,    // wallet_address_hash (AZ-032)
        std::hash::pedersen_hash([MOCK_WALLET_HASH as Field, MOCK_IDENTITY_SALT]), // identity_commitment
        65,                  // kyc_score (private)
        2,                   // tier (private)
    );
}

#[test]
fn test_tier1_nigeria_within_cap_passes() {
    // Score 50 → tier 1, Nigeria (566), 10 ACBU of 100 ACBU cap
    main(
        1,              // min_tier
        566,            // country_code = NG
        100_000_000,    // requested_amount = 10 ACBU (7 dec)
        1_000_000_000,  // daily_cap = 100 ACBU
        0,              // already_used
        MOCK_WALLET_HASH, // wallet_address_hash (AZ-032)
        std::hash::pedersen_hash([MOCK_WALLET_HASH as Field, MOCK_IDENTITY_SALT]), // identity_commitment
        50,             // kyc_score (private)
        1,              // tier (private)
    );
}

#[test]
fn test_tier1_exact_cap_boundary_passes() {
    // Consuming exactly the daily cap (100 ACBU) must succeed.
    main(
        1,              // min_tier
        566,            // country_code = NG
        1_000_000_000,  // requested_amount = 100 ACBU
        1_000_000_000,  // daily_cap = 100 ACBU
        0,              // already_used
        MOCK_WALLET_HASH, // wallet_address_hash (AZ-032)
        std::hash::pedersen_hash([MOCK_WALLET_HASH as Field, MOCK_IDENTITY_SALT]), // identity_commitment
        45,             // kyc_score
        1,              // tier
    );
}

#[test]
fn test_tier2_partially_used_window_passes() {
    // 5 000 ACBU already used, requesting 4 999 ACBU, cap 10 000 ACBU
    main(
        2,                    // min_tier
        566,                  // country_code = NG
        49_990_000_000,       // requested_amount = 4 999 ACBU
        100_000_000_000,      // daily_cap = 10 000 ACBU
        50_000_000_000,       // already_used = 5 000 ACBU
        MOCK_WALLET_HASH,     // wallet_address_hash (AZ-032)
        std::hash::pedersen_hash([MOCK_WALLET_HASH as Field, MOCK_IDENTITY_SALT]), // identity_commitment
        70,                   // kyc_score
        2,                    // tier
    );
}

#[test]
fn test_tier1_kenya_passes() {
    // Kenya (ISO 3166-1 numeric: 404) is on the tier-1 allow-list.
    main(
        1,
        404,              // KE
        100_000_000,      // 10 ACBU
        1_000_000_000,    // 100 ACBU cap
        0,
        MOCK_WALLET_HASH, // wallet_address_hash (AZ-032)
        std::hash::pedersen_hash([MOCK_WALLET_HASH as Field, MOCK_IDENTITY_SALT]), // identity_commitment
        35,
        1,
    );
}

#[test]
fn test_score_boundary_30_becomes_tier1() {
    // Exact boundary: score == 30 must resolve to tier 1.
    main(
        1,
        566,
        100_000_000,
        1_000_000_000,
        0,
        MOCK_WALLET_HASH, // wallet_address_hash (AZ-032)
        std::hash::pedersen_hash([MOCK_WALLET_HASH as Field, MOCK_IDENTITY_SALT]), // identity_commitment
        30,  // boundary
        1,
    );
}

#[test]
fn test_score_boundary_60_becomes_tier2() {
    main(
        2,
        566,
        100_000_000,
        100_000_000_000,
        0,
        MOCK_WALLET_HASH, // wallet_address_hash (AZ-032)
        std::hash::pedersen_hash([MOCK_WALLET_HASH as Field, MOCK_IDENTITY_SALT]), // identity_commitment
        60,  // boundary
        2,
    );
}

#[test]
fn test_score_boundary_90_becomes_tier3() {
    main(
        3,
        566,
        100_000_000,
        0xFFFFFFFFFFFFFFFF,
        0,
        MOCK_WALLET_HASH, // wallet_address_hash (AZ-032)
        std::hash::pedersen_hash([MOCK_WALLET_HASH as Field, MOCK_IDENTITY_SALT]), // identity_commitment
        90,  // boundary
        3,
    );
}

// ── Negative tests (AZ-019) ─────────────────────────────────────────────────
// Assert that constraint failures reject proofs. Without these, a regression
// that weakens tier/country/score checks would still pass CI.

#[test(should_fail_with = "account tier does not meet minimum requirement")]
fn test_rejects_under_kyc_tier_below_min() {
    // Score 50 → tier 1, but min_tier requires 2 (under-KYC'd).
    main(
        2,              // min_tier
        566,            // NG (allowed for tier 1, irrelevant here)
        100_000_000,    // 10 ACBU
        1_000_000_000,  // cap
        0,
        MOCK_WALLET_HASH, // wallet_address_hash (AZ-032)
        std::hash::pedersen_hash([MOCK_WALLET_HASH as Field, MOCK_IDENTITY_SALT]), // identity_commitment
        50,             // kyc_score → tier 1
        1,              // tier
    );
}

#[test(should_fail_with = "country not on tier-1 allow-list")]
fn test_rejects_wrong_country_for_tier1() {
    // Tier 1 with US (840) — not on the Africa allow-list.
    main(
        1,
        840,            // US — wrong country for tier 1
        100_000_000,
        1_000_000_000,
        0,
        MOCK_WALLET_HASH, // wallet_address_hash (AZ-032)
        std::hash::pedersen_hash([MOCK_WALLET_HASH as Field, MOCK_IDENTITY_SALT]), // identity_commitment
        50,
        1,
    );
}

#[test(should_fail_with = "tier must match kyc_score")]
fn test_rejects_mismatched_tier_and_score() {
    // Private inputs inconsistent: score 95 derives tier 3, but claimed tier is 2.
    // Analogous to a wrong-nullifier / forged witness regression.
    main(
        2,
        566,
        100_000_000,
        100_000_000_000,
        0,
        MOCK_WALLET_HASH, // wallet_address_hash (AZ-032)
        std::hash::pedersen_hash([MOCK_WALLET_HASH as Field, MOCK_IDENTITY_SALT]), // identity_commitment
        95,             // derives tier 3
        2,              // claimed tier 2 — mismatch
    );
}

#[test(should_fail_with = "tier 0 accounts cannot transact")]
fn test_rejects_tier0_blocked() {
    main(
        0,
        566,
        100_000_000,
        1_000_000_000,
        0,
        MOCK_WALLET_HASH, // wallet_address_hash (AZ-032)
        std::hash::pedersen_hash([MOCK_WALLET_HASH as Field, MOCK_IDENTITY_SALT]), // identity_commitment
        10,             // score < 30 → tier 0
        0,
    );
}

#[test(should_fail_with = "requested_amount must be positive")]
fn test_rejects_zero_requested_amount() {
    main(
        1,
        566,
        0,              // zero amount
        1_000_000_000,
        0,
        MOCK_WALLET_HASH, // wallet_address_hash (AZ-032)
        std::hash::pedersen_hash([MOCK_WALLET_HASH as Field, MOCK_IDENTITY_SALT]), // identity_commitment
        50,
        1,
    );
}

#[test(should_fail_with = "daily cap exceeded")]
fn test_rejects_daily_cap_exceeded() {
    // already_used 90 + request 20 > cap 100
    main(
        1,
        566,
        200_000_000,    // 20 ACBU
        1_000_000_000,  // 100 ACBU cap
        900_000_000,    // 90 ACBU already used
        MOCK_WALLET_HASH, // wallet_address_hash (AZ-032)
        std::hash::pedersen_hash([MOCK_WALLET_HASH as Field, MOCK_IDENTITY_SALT]), // identity_commitment
        50,
        1,
    );
}

#[test(should_fail_with = "kyc_score must be <= 100")]
fn test_rejects_kyc_score_out_of_range() {
    main(
        1,
        566,
        100_000_000,
        1_000_000_000,
        0,
        MOCK_WALLET_HASH, // wallet_address_hash (AZ-032)
        std::hash::pedersen_hash([MOCK_WALLET_HASH as Field, MOCK_IDENTITY_SALT]), // identity_commitment
        101,            // invalid score
        1,
    );
}

#[test(should_fail_with = "account tier does not meet minimum requirement")]
fn test_rejects_tier2_when_min_tier3_required() {
    // Score 70 → tier 2 cannot satisfy institutional min_tier 3.
    main(
        3,
        566,
        100_000_000,
        0xFFFFFFFFFFFFFFFF,
        0,
        MOCK_WALLET_HASH, // wallet_address_hash (AZ-032)
        std::hash::pedersen_hash([MOCK_WALLET_HASH as Field, MOCK_IDENTITY_SALT]), // identity_commitment
        70,
        2,
    );
}

#[test(should_fail_with = "country not on tier-1 allow-list")]
fn test_rejects_tier1_china_not_allowlisted() {
    // China (156) is outside the tier-1 allow-list.
    main(
        1,
        156,            // CN
        100_000_000,
        1_000_000_000,
        0,
        MOCK_WALLET_HASH, // wallet_address_hash (AZ-032)
        std::hash::pedersen_hash([MOCK_WALLET_HASH as Field, MOCK_IDENTITY_SALT]), // identity_commitment
        40,
        1,
    );
}

// ── AZ-032 negative test ─────────────────────────────────────────────────────

#[test(should_fail_with = "wallet_address_hash must be non-zero (AZ-032)")]
fn test_rejects_zero_wallet_address_hash() {
    // A zero wallet_address_hash means the prover did not bind the proof to
    // any caller — this must be rejected at the circuit level.
    main(
        1,
        566,
        100_000_000,
        1_000_000_000,
        0,
        0,              // wallet_address_hash = 0 (unbound — must fail)
        std::hash::pedersen_hash([0 as Field, MOCK_IDENTITY_SALT]), // identity_commitment
        50,
        1,
    );

// ── W10-SEC-015 negative tests ───────────────────────────────────────────────

#[test(should_fail_with = "identity_commitment must be non-zero (W10-SEC-015)")]
fn test_rejects_zero_identity_commitment() {
    // A zero identity_commitment means the prover did not bind the proof to
    // any account — this must be rejected at the circuit level.
    main(
        1,
        566,
        100_000_000,
        1_000_000_000,
        0,
        MOCK_WALLET_HASH,
        0,              // identity_commitment = 0 (unbound — must fail)
        50,
        1,
    );
}

#[test(should_fail_with = "identity_commitment mismatch (W10-SEC-015)")]
fn test_rejects_identity_commitment_for_wrong_account() {
    // Commitment derived from a different wallet hash must not verify for
    // this wallet — prevents replaying a proof to a different account.
    let other_wallet_hash: u128 = 0x1112131415161718191a1b1c1d1e1f20;
    main(
        1,
        566,
        100_000_000,
        1_000_000_000,
        0,
        MOCK_WALLET_HASH,
        std::hash::pedersen_hash([other_wallet_hash as Field, MOCK_IDENTITY_SALT]), // commitment for other account
        50,
        1,
    );
}
}
