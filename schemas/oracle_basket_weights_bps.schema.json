{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Oracle Basket Weights BPS",
  "description": "Currency basket weights in basis points (scripts format)",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "array",
    "description": "[currency_tuple, weight_bps]",
    "minItems": 2,
    "maxItems": 2,
    "prefixItems": [
      {
        "type": "array",
        "description": "Single-element tuple wrapping the currency code",
        "minItems": 1,
        "maxItems": 1,
        "items": {
          "type": "string",
          "pattern": "^[A-Z]{2,4}$"
        }
      },
      {
        "type": "integer",
        "description": "Weight in basis points (1–10000)",
        "minimum": 1,
        "maximum": 10000
      }
    ]
  }
}
