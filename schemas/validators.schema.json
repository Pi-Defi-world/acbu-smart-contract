{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Validators",
  "description": "List of authorised Stellar validator addresses for the ACBU oracle",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "string",
    "description": "Stellar public key (StrKey G-address)",
    "pattern": "^G[A-Z2-7]{55}$"
  },
  "uniqueItems": true
}
