{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Basket Weights",
  "description": "Currency basket weights stored as Soroban Map entries",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["key", "val"],
    "additionalProperties": false,
    "properties": {
      "key": {
        "type": "object",
        "required": ["SorobanString"],
        "additionalProperties": false,
        "properties": {
          "SorobanString": {
            "type": "string",
            "description": "ISO 4217 currency code",
            "pattern": "^[A-Z]{2,4}$",
            "minLength": 2,
            "maxLength": 4
          }
        }
      },
      "val": {
        "type": "integer",
        "description": "Weight in basis points (1–10000)",
        "minimum": 1,
        "maximum": 10000
      }
    }
  },
  "maxItems": 20
}
